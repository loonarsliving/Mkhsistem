    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.20",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
