    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.3.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.20",
    "next-themes": "^0.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.54.2",
