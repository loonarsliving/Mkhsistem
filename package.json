{
  "name": "mk-connect",
  "version": "1.0.0",
  "private": true,
  "description": "MK Connect - Internal Communication & Attendance System for PT Maha Karya Haluoleo",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > types/database.types.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "backup:db": "tsx scripts/backup-database.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
