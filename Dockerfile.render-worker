# Standalone Render Engine worker (KontenAI Sprint 6) -- runs
# scripts/render-worker.ts continuously on its own host (Fly.io, Railway, a
# VPS, anywhere). Deploy this image separately from the main Next.js app on
# Vercel; it only needs Supabase + Google Drive env vars, never the rest of
# MK Connect's runtime config.
#
# Node 22+ (not 20): @supabase/realtime-js constructs a RealtimeClient on
# every createClient() call and needs the native `WebSocket` global that
# only landed in Node 22 -- on Node 20 it throws "native WebSocket not
# found" the moment the admin client is created, even though this worker
# never actually uses realtime subscriptions.
FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
# Full install (not --omit=dev): tsx/typescript (devDependencies) are what
# actually run this script -- this image never ships to Vercel, so bundle
# size doesn't matter the way it does for the Next.js app.
RUN npm ci

COPY tsconfig.json ./
COPY scripts ./scripts
COPY lib ./lib
COPY repositories ./repositories
COPY types ./types

# lib/**/*.ts is shared with the Next.js app and marks server-only modules
# with `import "server-only"` -- a conditional export that Next's bundler
# resolves to a no-op via the "react-server" condition, but that plain Node
# resolves to the throwing default export. Setting the same condition here
# keeps those shared files importable without forking them for the worker.
ENV NODE_OPTIONS="--conditions=react-server"

CMD ["npx", "tsx", "scripts/render-worker.ts"]
