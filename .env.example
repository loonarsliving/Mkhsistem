# ─────────────────────────────────────────────────────────────
# MK Connect — Environment Variables
# Copy this file to .env.local and fill in the values from your
# Supabase project (Project Settings → API).
# ─────────────────────────────────────────────────────────────

# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MK Connect"

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `npm run supabase:types`
SUPABASE_PROJECT_ID=your-project-ref

# ─────────────────────────────────────────────────────────────
# AI Operating System — Gemini (AI Service) + WhatsApp Cloud API
# ─────────────────────────────────────────────────────────────

# Which lib/ai/provider/registry.ts AIProvider implementation is used.
# Only "gemini" is implemented today -- an explicit config value so a second
# provider (OpenAI/Claude/OpenRouter) is a one-line switch, not a code change.
AI_PROVIDER=gemini

# Server-only. Get from Google AI Studio. Leave blank to disable AI features
# (lib/ai/service.ts fails loud with a clear error instead of a silent no-op).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_MS=20000
AI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
# Retry/backoff for transient Gemini failures (429/500/502/503/504, timeouts).
# Attempt 1 is immediate; attempts 2..N wait GEMINI_RETRY_BASE_DELAY_MS * 2^(n-1)
# (+/-20% jitter) -- the defaults below give 20s/40s/80s before attempts 2/3/4.
# In production these retries happen across separate ai_job_queue dispatches
# (see migration 0065_ai_resilience_platform.sql), never as an in-process
# sleep, so a Vercel function invocation can never block long enough to hit
# its duration limit no matter how many attempts a job needs.
GEMINI_RETRY_MAX_ATTEMPTS=4
GEMINI_RETRY_BASE_DELAY_MS=20000
# How long a successful AI health check is cached before probing Gemini again.
AI_HEALTHCHECK_CACHE_MS=300000
# Shared (DB-backed) circuit breaker for the Gemini provider -- trips open
# after AI_CIRCUIT_FAILURE_THRESHOLD consecutive failures across ALL
# concurrent Vercel instances, and short-circuits new calls (failing fast
# with the friendly fallback instead of hammering an already-struggling
# provider) until AI_CIRCUIT_OPEN_COOLDOWN_MS has elapsed, at which point it
# allows one probe call through (half_open) before fully resetting.
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_COOLDOWN_MS=60000

# Server-only. From Meta Developer > WhatsApp > API Setup / Configuration.
# All four must be set for the WhatsApp connector to activate; otherwise
# every send/webhook call reports "not configured" instead of failing.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Set this to any secret string; enter the SAME value as the "Verify Token"
# when registering https://<your-domain>/api/integrations/whatsapp/webhook
# in Meta's Webhook configuration.
WHATSAPP_VERIFY_TOKEN=
