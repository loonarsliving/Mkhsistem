# ─────────────────────────────────────────────────────────────
# MK Connect — Environment Variables
# Copy this file to .env.local and fill in the values from your
# Supabase project (Project Settings → API).
# ─────────────────────────────────────────────────────────────

# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MK Connect"

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `npm run supabase:types`
SUPABASE_PROJECT_ID=your-project-ref

# ─────────────────────────────────────────────────────────────
# AI Operating System — Gemini (AI Service) + WhatsApp Cloud API
# ─────────────────────────────────────────────────────────────

# Which lib/ai/provider/registry.ts AIProvider implementation is used.
# Only "gemini" is implemented today -- an explicit config value so a second
# provider (OpenAI/Claude/OpenRouter) is a one-line switch, not a code change.
AI_PROVIDER=gemini

# Server-only. Get from Google AI Studio. Leave blank to disable AI features
# (lib/ai/service.ts fails loud with a clear error instead of a silent no-op).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_MS=20000
AI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
# Retry/backoff for transient Gemini failures (429/500/502/503/504, timeouts).
# Attempt 1 is immediate; attempts 2..N wait GEMINI_RETRY_BASE_DELAY_MS * 2^(n-1)
# (+/-20% jitter) -- the defaults below give 20s/40s/80s before attempts 2/3/4.
# In production these retries happen across separate ai_job_queue dispatches
# (see migration 0065_ai_resilience_platform.sql), never as an in-process
# sleep, so a Vercel function invocation can never block long enough to hit
# its duration limit no matter how many attempts a job needs.
GEMINI_RETRY_MAX_ATTEMPTS=4
GEMINI_RETRY_BASE_DELAY_MS=20000
# How long a successful AI health check is cached before probing Gemini again.
AI_HEALTHCHECK_CACHE_MS=300000
# Shared (DB-backed) circuit breaker for the Gemini provider -- trips open
# after AI_CIRCUIT_FAILURE_THRESHOLD consecutive failures across ALL
# concurrent Vercel instances, and short-circuits new calls (failing fast
# with the friendly fallback instead of hammering an already-struggling
# provider) until AI_CIRCUIT_OPEN_COOLDOWN_MS has elapsed, at which point it
# allows one probe call through (half_open) before fully resetting.
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_COOLDOWN_MS=60000

# Google Drive client (lib/google-drive/client.ts) -- currently UNUSED by
# every KontenAI storage path (Asset Library uploads and Veo-generated clips
# both write to Supabase Storage). A service account has no storage quota of
# its own, so uploading into a folder it's merely been given Editor access
# to fails with HTTP 403 unless that folder lives inside a real Shared Drive
# (a Google Workspace feature) -- not worth pursuing without one. These vars
# are harmless to leave set; nothing reads them right now.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Render Engine worker (scripts/render-worker.ts / Dockerfile.render-worker)
# -- runs on its OWN host (Fly.io/Railway/VPS), not on Vercel, so ffmpeg
# renders never risk a serverless function's duration/memory limits. Needs
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (above). Optional:
RENDER_WORKER_POLL_INTERVAL_MS=5000

# Veo image-to-video worker (scripts/veo-worker.ts) -- also runs on that
# same host (see scripts/worker-main.ts, which runs both workers together).
# Separate subscription/API key from GEMINI_API_KEY. Leave blank to disable
# -- video-generation jobs just stay queued until it's configured.
VEO_API_KEY=
VEO_MODEL=veo-2.0-generate-001
VEO_WORKER_POLL_INTERVAL_MS=10000

# Server-only. Actual sending/status goes through the Whacenter gateway
# (https://app.whacenter.com), keyed by the device ID of the paired WhatsApp
# session in your Whacenter dashboard. This is the one value that must be set
# for the WhatsApp connector to activate -- without it, every send/webhook
# call reports "not configured" instead of failing.
WHACENTER_DEVICE_ID=
# The four below are unused Meta Cloud API leftovers from an earlier
# integration attempt, kept only because WHATSAPP_VERIFY_TOKEN still guards
# the /api/integrations/whatsapp/webhook endpoint. Set this to any secret
# string and enter the SAME value if/when that webhook is registered somewhere.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ─────────────────────────────────────────────────────────────
# Meta Marketing API — Ads Specialist module (lib/meta/*)
# Separate from the WhatsApp Cloud API leftovers above: this is the real
# Meta Business Suite / Graph API integration used to run Click-to-WhatsApp
# ads. Get these from Meta Business Suite / Graph API Explorer / Business
# Settings. Never commit real values -- set them in Vercel Environment
# Variables only.
# ─────────────────────────────────────────────────────────────
META_API_VERSION=v21.0
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_BUSINESS_ID=
META_IG_USER_ID=
# International format, digits only (e.g. 6281343333371) -- the number ads
# should drive WhatsApp leads to. The actual Click-to-WhatsApp destination is
# whichever WhatsApp Business Account is linked to META_PAGE_ID in Business
# Manager; this value is only used to render the ad creative's wa.me link.
META_WHATSAPP_PHONE_NUMBER=
# Hard ceiling (IDR) on total daily ad spend the AI may commit across all
# active campaigns. 0 = AI cannot launch or scale any campaign (fails
# closed) -- must be set explicitly before autonomous ad launch is allowed.
META_ADS_DAILY_BUDGET_CAP_IDR=0

# ─────────────────────────────────────────────────────────────
# TikTok for Business API — Content Planner module (lib/social/tiktok.ts)
# Separate developer registration from Meta -- business-api.tiktok.com.
# Needs a verified TikTok Business account first. Never commit real
# values -- set them in Vercel Environment Variables only.
# ─────────────────────────────────────────────────────────────
TIKTOK_API_VERSION=v1.3
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ─────────────────────────────────────────────────────────────
# Voice bridge — app/api/ai/voice-bridge & voice-assistant routes, called by
# the Ultron voice assistant (separate "filehub" Vercel deployment). OPTIONAL:
# defaults to https://filemanager.haluoleo.id (see lib/ai/voice-bridge/cors.ts)
# -- only set this if Ultron ever moves to a different domain.
# ─────────────────────────────────────────────────────────────
VOICE_BRIDGE_ALLOWED_ORIGIN=
