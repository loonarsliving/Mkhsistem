# ─────────────────────────────────────────────────────────────
# MK Connect — Environment Variables
# Copy this file to .env.local and fill in the values from your
# Supabase project (Project Settings → API).
# ─────────────────────────────────────────────────────────────

# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MK Connect"
# Web Push (VAPID) public key -- generate a pair with `npx web-push generate-vapid-keys`.
# The private key is never used by this app; it lives only in the Supabase
# send-push Edge Function (see supabase/functions/send-push).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by `npm run supabase:types`
SUPABASE_PROJECT_ID=your-project-ref
